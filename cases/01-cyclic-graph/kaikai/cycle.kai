import loop

type Node = { id: Int, next: Ref[Option[Node]] }

fn make_node(id: Int) : Node / Mutable = Node { id: id, next: &None }

fn step(n: Node) : Node / Mutable = match @n.next {
  Some(m) -> m
  None    -> n
}

fn main() : Int / Stdout + Mutable = {
  let a = make_node(1)
  let b = make_node(2)
  a.next := Some(b)
  b.next := Some(a)

  var cur := a
  var steps := 0
  var trace := ""
  while { steps < 6 } {
    trace := "#{trace}#{int_to_string(cur.id)} "
    cur := step(cur)
    steps := steps + 1
  }
  Stdout.print("trace=#{trace}")
  0
}
