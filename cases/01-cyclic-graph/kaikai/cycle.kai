import loop

type Slot = Empty | Has(Node)
type Node = { id: Int, next: Ref[Slot] }

fn make_node(id: Int) : Node / Mutable = Node { id: id, next: Mutable.ref_make(Empty) }

fn step(n: Node) : Node / Mutable = match Mutable.ref_get(n.next) {
  Has(m) -> m
  Empty  -> n
}

fn main() : Int / Stdout + Mutable = {
  let a = make_node(1)
  let b = make_node(2)
  a.next.set(Has(b))
  b.next.set(Has(a))

  var cur := a
  var steps := 0
  var trace := ""
  while { steps < 6 } {
    trace := "#{trace}#{int_to_string(cur.id)} "
    cur := step(cur)
    steps := steps + 1
  }
  Stdout.print("trace=#{trace}")
  0
}
